      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Junta os registros num único objeto e protege o que é sensível.\n// O dashboard é público: perguntas sensíveis aparecem só como contagem.\nconst registros = $input.all()\n  .map((item) => item.json)\n  .filter((l) => l.pergunta)\n  .map((l) => ({\n    data: l.data,\n    tema: l.tema,\n    status: l.status,\n    motivo_encaminhamento: l.motivo_encaminhamento || null,\n    fontes: l.fontes || '',\n    pergunta: l.motivo_encaminhamento === 'sensivel' ? null : l.pergunta,\n  }));\n\nreturn [{ json: { registros } }];\n"
      },
      "id": "c3e982f5-26c4-4a63-b6cb-62aa4e92d021",
      "name": "juntar_registros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "1h2zhqhxczAULQW2Il0lI8px0kq4rNmXv7SCHZSnXoMY",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "analises",
          "mode": "name"
        },
        "options": {}
      },
      "id": "70b62f0a-1a34-4d53-9686-3aed903b79e6",
      "name": "ler_analises",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Monta a resposta final: registros + análise mais recente.\nconst { registros } = $('juntar_registros').first().json;\n\nconst linhas = $input.all().map((i) => i.json).filter((l) => l.analise_json);\nconst ultima = linhas[linhas.length - 1];\n\nlet analise = null;\nif (ultima) {\n  try {\n    analise = { data: ultima.data, ...JSON.parse(ultima.analise_json) };\n  } catch (erro) {\n    analise = null;\n  }\n}\n\nreturn [{ json: { atualizado_em: new Date().toISOString(), registros, analise } }];\n"
      },
      "id": "cd65e82f-86e0-4233-9503-ead386fc43bd",
      "name": "montar_resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
